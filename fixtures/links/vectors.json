    {"id": "lx-protocol-relative", "lane": "prod", "note": "#//evil.example/ must not become '//evil.example/' (open redirect): empty identifier, malformed.", "input": "https://matrix.to/#//evil.example/", "expect": {"reject": "malformed"}},
