{
  "version": 1,
  "spec": "SPEC-deeplink.md §4 (grammar), §4.5 (vector format). Every implementation (zymi-core, the landing page, any client parser) must pass every entry here, byte for byte.",
  "about": {
    "lanes": "Fixture configs, one per build, not deployment truth; a parser accepts every scheme listed in its config. Schemes follow SPEC-deeplink.md §5.3: zymi for prod, zymi-<lane> for the other lanes, zymi-debug for Debug builds on the local stack (owner, 11-13). prod: default host of B2, server_name zymi.app (zim SPEC-zymi-matrix-session.md:33), scheme zymi on iOS and macOS. dev: default host of B2, server_name assumed zymi.app like prod (unconfirmed, review U6), scheme zymi-dev (zymi-ios's dev callback_scheme, zim Release). local: zim Debug on the local E2E stack (B4), server_name localhost:8448 (zim dev/fake-zymi/state-e2e/e2e.json), scheme zymi-debug, host to-local.zymi.test (a .test name, E2E only).",
    "parse_expect": "One of: {link, source} = ours and valid; {reject: reason} = ours but invalid, show 'link invalid' and never hand it to the system; {not_ours: true} = not a link of ours, leave it to the system as before; {other_lane: name} = a link of another lane of ours.",
    "reasons": "malformed (bad shape, bad encoding, bad id), unknown_kind (unknown or unsupported kind, including Zymi kinds under matrix:), reserved (a kind reserved for later: invite, team), foreign_server (a user, alias or pre-v12 room id on a server that is not the lane's server_name).",
    "sources": "canonical (https on the lane's host), scheme (<lane scheme>://open/...), matrix_to (fragment form on a legacy base), matrix_uri (matrix: URI, MSC2312), zymix (zymix://unseal/...).",
    "other_lanes": "Each build's config lists every other lane of this file as its other lanes: its name, its hosts and its schemes (the distinct values of its schemes map).",
    "input_bound": "Input over 4096 bytes is not parsed whole: only its first 4096 bytes are read (cut back to a character boundary) and classified by the usual rules. If that head is a link or a reject of ours, the answer is reject malformed (never handed to the system); other_lane and not_ours stay as they are, so a long link to our host's root or to a legacy base without '#/' is not_ours.",
    "build_expect": "{url, handoff?} where url is the only byte sequence a builder may produce and handoff maps platform to the scheme form; or {error: invalid_id | foreign_server}. Each built url and handoff must parse back to the same link (checked by every implementation's test)."
  },
  "lanes": {
    "prod": {
      "hosts": [
        "to.zymi.app"
      ],
      "server_name": "zymi.app",
      "schemes": {
        "ios": "zymi",
        "macos": "zymi"
      }
    },
    "dev": {
      "hosts": [
        "to-dev.zymi.app"
      ],
      "server_name": "zymi.app",
      "schemes": {
        "ios": "zymi-dev",
        "macos": "zymi-dev"
      }
    },
    "local": {
      "hosts": [
        "to-local.zymi.test"
      ],
      "server_name": "localhost:8448",
      "schemes": {
        "macos": "zymi-debug"
      }
    }
  },
  "legacy": {
    "fragment_bases": [
      "https://matrix.to/",
      "https://dev.unseal.chat/AgentMessenger/to-share/"
    ],
    "schemes": {
      "zymix": "unseal",
      "zymixdemo": "unseal"
    }
  },
  "build": [
    {"id": "b-user", "lane": "prod", "note": "User: the id without '@', ':' left as is (never %3A).", "link": {"kind": "user", "user_id": "@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}, "expect": {"url": "https://to.zymi.app/u/0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app", "handoff": {"ios": "zymi://open/u/0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app", "macos": "zymi://open/u/0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}}},
    {"id": "b-user-port", "lane": "local", "note": "Server name with a port: both colons stay literal; handoff is the same path behind <scheme>://open.", "link": {"kind": "user", "user_id": "@b4ec4a80-1111-4222-8333-444455556666:localhost:8448"}, "expect": {"url": "https://to-local.zymi.test/u/b4ec4a80-1111-4222-8333-444455556666:localhost:8448", "handoff": {"macos": "zymi-debug://open/u/b4ec4a80-1111-4222-8333-444455556666:localhost:8448"}}},
    {"id": "b-room-v12", "lane": "local", "note": "Room v12 id (no ':server', what the local Synapse makes): /roomid/<opaque>.", "link": {"kind": "room", "room_id": "!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30"}, "expect": {"url": "https://to-local.zymi.test/roomid/owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30", "handoff": {"macos": "zymi-debug://open/roomid/owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30"}}},
    {"id": "b-room-old", "lane": "prod", "note": "Pre-v12 room id with ':server'.", "link": {"kind": "room", "room_id": "!abcDEF123:zymi.app"}, "expect": {"url": "https://to.zymi.app/roomid/abcDEF123:zymi.app", "handoff": {"ios": "zymi://open/roomid/abcDEF123:zymi.app", "macos": "zymi://open/roomid/abcDEF123:zymi.app"}}},
    {"id": "b-event-v12", "lane": "prod", "note": "Message in a v12 room; event id is url-safe base64 ('-', '_' kept).", "link": {"kind": "room", "room_id": "!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30", "event_id": "$Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4"}, "expect": {"url": "https://to.zymi.app/roomid/owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30/e/Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4", "handoff": {"ios": "zymi://open/roomid/owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30/e/Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4", "macos": "zymi://open/roomid/owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30/e/Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4"}}},
    {"id": "b-event-std-b64", "lane": "prod", "note": "Room v3 event id in standard base64: '+' and '/' are percent-encoded, upper-case hex.", "link": {"kind": "room", "room_id": "!abcDEF123:zymi.app", "event_id": "$Ab+Cd/Ef"}, "expect": {"url": "https://to.zymi.app/roomid/abcDEF123:zymi.app/e/Ab%2BCd%2FEf", "handoff": {"ios": "zymi://open/roomid/abcDEF123:zymi.app/e/Ab%2BCd%2FEf", "macos": "zymi://open/roomid/abcDEF123:zymi.app/e/Ab%2BCd%2FEf"}}},
    {"id": "b-alias", "lane": "prod", "note": "Alias: /r/<alias without '#'>.", "link": {"kind": "room", "room_alias": "#team-alpha:zymi.app"}, "expect": {"url": "https://to.zymi.app/r/team-alpha:zymi.app", "handoff": {"ios": "zymi://open/r/team-alpha:zymi.app", "macos": "zymi://open/r/team-alpha:zymi.app"}}},
    {"id": "b-alias-utf8", "lane": "prod", "note": "Non-ASCII alias: UTF-8 bytes percent-encoded, upper-case hex.", "link": {"kind": "room", "room_alias": "#产品讨论:zymi.app"}, "expect": {"url": "https://to.zymi.app/r/%E4%BA%A7%E5%93%81%E8%AE%A8%E8%AE%BA:zymi.app", "handoff": {"ios": "zymi://open/r/%E4%BA%A7%E5%93%81%E8%AE%A8%E8%AE%BA:zymi.app", "macos": "zymi://open/r/%E4%BA%A7%E5%93%81%E8%AE%A8%E8%AE%BA:zymi.app"}}},
    {"id": "b-task", "lane": "dev", "note": "Zymi task.", "link": {"kind": "task", "id": "deck"}, "expect": {"url": "https://to-dev.zymi.app/task/deck", "handoff": {"ios": "zymi-dev://open/task/deck", "macos": "zymi-dev://open/task/deck"}}},
    {"id": "b-agent-case", "lane": "prod", "note": "Zymi ids keep their case (catalog has upper- and lower-case UUIDs).", "link": {"kind": "agent", "id": "0A4C7B1E-5D2F-4C8A-9B3E-1F2A3B4C5D01"}, "expect": {"url": "https://to.zymi.app/agent/0A4C7B1E-5D2F-4C8A-9B3E-1F2A3B4C5D01", "handoff": {"ios": "zymi://open/agent/0A4C7B1E-5D2F-4C8A-9B3E-1F2A3B4C5D01", "macos": "zymi://open/agent/0A4C7B1E-5D2F-4C8A-9B3E-1F2A3B4C5D01"}}},
    {"id": "b-artifact", "lane": "prod", "note": "Zymi artifact.", "link": {"kind": "artifact", "id": "a1"}, "expect": {"url": "https://to.zymi.app/artifact/a1", "handoff": {"ios": "zymi://open/artifact/a1", "macos": "zymi://open/artifact/a1"}}},
    {"id": "b-bad-zymi-id", "lane": "prod", "note": "A Zymi id outside [A-Za-z0-9_-]{1,128} is never built (no dots, so no dot segments).", "link": {"kind": "task", "id": "a.b"}, "expect": {"error": "invalid_id"}},
    {"id": "b-foreign-user", "lane": "prod", "note": "No link is built for a user on another server.", "link": {"kind": "user", "user_id": "@x:evil.example"}, "expect": {"error": "foreign_server"}},
    {"id": "b-bad-event-dots", "lane": "prod", "note": "An event id outside the event grammar (here '..', a dot segment that would normalise to another link) is never built.", "link": {"kind": "room", "room_id": "!abcDEF123:zymi.app", "event_id": "$.."}, "expect": {"error": "invalid_id"}},
    {"id": "b-bad-user-sigil", "lane": "prod", "note": "A localpart may not start with the id's own sigil ('@@x').", "link": {"kind": "user", "user_id": "@@x:zymi.app"}, "expect": {"error": "invalid_id"}},
    {"id": "b-bad-alias-bidi", "lane": "prod", "note": "Format characters (Unicode Cf: bidi controls, zero-width) are refused in every Matrix id.", "link": {"kind": "room", "room_alias": "#a‮b:zymi.app"}, "expect": {"error": "invalid_id"}}
  ],
  "parse": [
    {"id": "p-user", "lane": "prod", "note": "Canonical user link.", "input": "https://to.zymi.app/u/0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app", "expect": {"link": {"kind": "user", "user_id": "@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}, "source": "canonical"}},
    {"id": "p-user-encoded-colon", "lane": "prod", "note": "':' as %3A (what encodeURIComponent writes) is accepted, though never built.", "input": "https://to.zymi.app/u/0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70%3Azymi.app", "expect": {"link": {"kind": "user", "user_id": "@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}, "source": "canonical"}},
    {"id": "p-user-port", "lane": "local", "note": "Split at the first ':': localpart 'b4ec…', server 'localhost:8448'.", "input": "https://to-local.zymi.test/u/b4ec4a80-1111-4222-8333-444455556666:localhost:8448", "expect": {"link": {"kind": "user", "user_id": "@b4ec4a80-1111-4222-8333-444455556666:localhost:8448"}, "source": "canonical"}},
    {"id": "p-room-v12", "lane": "local", "note": "v12 room id: no server to check; it belongs to this lane because the host does.", "input": "https://to-local.zymi.test/roomid/owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30", "expect": {"link": {"kind": "room", "room_id": "!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30"}, "source": "canonical"}},
    {"id": "p-event-old-room", "lane": "prod", "note": "Pre-v12 room id plus event.", "input": "https://to.zymi.app/roomid/abcDEF123:zymi.app/e/Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4", "expect": {"link": {"kind": "room", "room_id": "!abcDEF123:zymi.app", "event_id": "$Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4"}, "source": "canonical"}},
    {"id": "p-event-encoded-slash", "lane": "prod", "note": "Split on literal '/' first, then decode: %2F inside an event id is part of the id, not a separator.", "input": "https://to.zymi.app/roomid/abcDEF123:zymi.app/e/Ab%2BCd%2FEf", "expect": {"link": {"kind": "room", "room_id": "!abcDEF123:zymi.app", "event_id": "$Ab+Cd/Ef"}, "source": "canonical"}},
    {"id": "p-alias-utf8", "lane": "prod", "note": "Alias decoded from UTF-8 percent-encoding.", "input": "https://to.zymi.app/r/%E4%BA%A7%E5%93%81%E8%AE%A8%E8%AE%BA:zymi.app", "expect": {"link": {"kind": "room", "room_alias": "#产品讨论:zymi.app"}, "source": "canonical"}},
    {"id": "p-alias-slash", "lane": "prod", "note": "Matrix allows '/' in an alias localpart; encoded as %2F it survives the split.", "input": "https://to.zymi.app/r/a%2Fb:zymi.app", "expect": {"link": {"kind": "room", "room_alias": "#a/b:zymi.app"}, "source": "canonical"}},
    {"id": "p-query-hash-ignored", "lane": "prod", "note": "Query (via, action, client, web-instance) and fragment are ignored; action=join never joins.", "input": "https://to.zymi.app/task/deck?via=evil.example&action=join&client=x&web-instance[element.io]=evil.example#frag", "expect": {"link": {"kind": "task", "id": "deck"}, "source": "canonical"}},
    {"id": "p-host-case-port", "lane": "prod", "note": "Host compared after WHATWG parsing: lower-cased, default port :443 dropped.", "input": "https://To.Zymi.App:443/task/deck", "expect": {"link": {"kind": "task", "id": "deck"}, "source": "canonical"}},
    {"id": "p-trailing-slash", "lane": "prod", "note": "One trailing slash is tolerated.", "input": "https://to.zymi.app/task/deck/", "expect": {"link": {"kind": "task", "id": "deck"}, "source": "canonical"}},
    {"id": "p-agent-case", "lane": "prod", "note": "Zymi id case is preserved.", "input": "https://to.zymi.app/agent/0A4C7B1E-5D2F-4C8A-9B3E-1F2A3B4C5D01", "expect": {"link": {"kind": "agent", "id": "0A4C7B1E-5D2F-4C8A-9B3E-1F2A3B4C5D01"}, "source": "canonical"}},
    {"id": "p-dot-segment-collapsed", "lane": "prod", "note": "Grammar applies to the WHATWG-normalised path: /roomid/../task/deck is /task/deck.", "input": "https://to.zymi.app/roomid/../task/deck", "expect": {"link": {"kind": "task", "id": "deck"}, "source": "canonical"}},
    {"id": "p-backslash", "lane": "prod", "note": "In https, WHATWG reads '\\' as '/': this is /task/deck.", "input": "https://to.zymi.app\\task\\deck", "expect": {"link": {"kind": "task", "id": "deck"}, "source": "canonical"}},
    {"id": "p-scheme", "lane": "prod", "note": "The canonical scheme form: zymi://open/<the https path> (prod's scheme).", "input": "zymi://open/task/deck", "expect": {"link": {"kind": "task", "id": "deck"}, "source": "scheme"}},
    {"id": "p-scheme-host-case", "lane": "dev", "note": "WHATWG keeps a custom scheme's host case; 'open' is compared case-insensitively.", "input": "zymi-dev://OPEN/roomid/owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30", "expect": {"link": {"kind": "room", "room_id": "!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30"}, "source": "scheme"}},
    {"id": "p-scheme-ios", "lane": "dev", "note": "Handoff form on iOS.", "input": "zymi-dev://open/u/0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app", "expect": {"link": {"kind": "user", "user_id": "@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}, "source": "scheme"}},
    {"id": "p-scheme-debug", "lane": "local", "note": "zim Debug's own scheme (Z1 drives the app under test through it).", "input": "zymi-debug://open/roomid/owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30", "expect": {"link": {"kind": "room", "room_id": "!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30"}, "source": "scheme"}},
    {"id": "x-root", "lane": "prod", "note": "The host's root is the web page, not a link: /task/.. normalises to '/'.", "input": "https://to.zymi.app/task/..", "expect": {"not_ours": true}},
    {"id": "x-encoded-dots", "lane": "prod", "note": "%2e%2e is a dot segment too (WHATWG): normalises to '/'.", "input": "https://to.zymi.app/task/%2e%2e", "expect": {"not_ours": true}},
    {"id": "x-kind-case", "lane": "prod", "note": "Kinds are lower-case and matched exactly.", "input": "https://to.zymi.app/U/x:zymi.app", "expect": {"reject": "unknown_kind"}},
    {"id": "x-empty-segment", "lane": "prod", "note": "An empty segment ('//') is malformed, never a protocol-relative address.", "input": "https://to.zymi.app//task/deck", "expect": {"reject": "malformed"}},
    {"id": "x-zymi-encoded-slash", "lane": "prod", "note": "Zymi ids are whitelisted [A-Za-z0-9_-]: a decoded '/' fails.", "input": "https://to.zymi.app/task/a%2Fb", "expect": {"reject": "malformed"}},
    {"id": "x-zymi-non-ascii", "lane": "prod", "note": "Zymi ids are ASCII only.", "input": "https://to.zymi.app/task/%E4%BD%A0", "expect": {"reject": "malformed"}},
    {"id": "x-bad-percent", "lane": "prod", "note": "A '%' not followed by two hex digits is malformed.", "input": "https://to.zymi.app/task/x%zz", "expect": {"reject": "malformed"}},
    {"id": "x-nul", "lane": "prod", "note": "Decoded control characters are malformed.", "input": "https://to.zymi.app/r/a%00:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "x-arity", "lane": "prod", "note": "Extra segments are malformed.", "input": "https://to.zymi.app/task/deck/extra", "expect": {"reject": "malformed"}},
    {"id": "x-user-no-server", "lane": "prod", "note": "A user id needs ':server'.", "input": "https://to.zymi.app/u/alice", "expect": {"reject": "malformed"}},
    {"id": "x-foreign-user", "lane": "prod", "note": "Federation is off: a user on another server is refused.", "input": "https://to.zymi.app/u/x:evil.example", "expect": {"reject": "foreign_server"}},
    {"id": "x-foreign-alias", "lane": "prod", "note": "Same for an alias.", "input": "https://to.zymi.app/r/team:evil.example", "expect": {"reject": "foreign_server"}},
    {"id": "x-foreign-old-room", "lane": "prod", "note": "Same for a pre-v12 room id's server.", "input": "https://to.zymi.app/roomid/abc:evil.example", "expect": {"reject": "foreign_server"}},
    {"id": "x-port-mismatch", "lane": "local", "note": "The server name includes its port: localhost:9999 is not localhost:8448.", "input": "https://to-local.zymi.test/u/b4ec4a80:localhost:9999", "expect": {"reject": "foreign_server"}},
    {"id": "x-reserved-invite", "lane": "prod", "note": "/invite/ is reserved in v1: no codes in links yet.", "input": "https://to.zymi.app/invite/ABC123", "expect": {"reject": "reserved"}},
    {"id": "x-credentials", "lane": "prod", "note": "Credentials on our host are malformed.", "input": "https://u:p@to.zymi.app/task/deck", "expect": {"reject": "malformed"}},
    {"id": "x-other-lane", "lane": "prod", "note": "A dev link seen by a prod build: say which lane, don't open it.", "input": "https://to-dev.zymi.app/task/deck", "expect": {"other_lane": "dev"}},
    {"id": "x-other-host", "lane": "prod", "note": "Any other host is not ours.", "input": "https://evil.example/task/deck", "expect": {"not_ours": true}},
    {"id": "x-http", "lane": "prod", "note": "Plain http is not a link of ours.", "input": "http://to.zymi.app/task/deck", "expect": {"not_ours": true}},
    {"id": "x-scheme-share", "lane": "dev", "note": "zymi-dev://share?inbox= belongs to the Share extension, not the link grammar.", "input": "zymi-dev://share?inbox=abc", "expect": {"not_ours": true}},
    {"id": "x-scheme-connectors", "lane": "dev", "note": "An outside <scheme>://connectors must not be read as a link (or as an OAuth completion).", "input": "zymi-dev://connectors?link_id=x", "expect": {"not_ours": true}},
    {"id": "x-scheme-dot-segment", "lane": "local", "note": "zymi-debug://open/../x normalises to zymi-debug://open/x: an unknown kind, not traversal.", "input": "zymi-debug://open/../x", "expect": {"reject": "unknown_kind"}},
    {"id": "x-scheme-empty", "lane": "dev", "note": "<scheme>://open with no path is ours but malformed.", "input": "zymi-dev://open", "expect": {"reject": "malformed"}},
    {"id": "x-other-port", "lane": "prod", "note": "A non-default port is another origin, not our host.", "input": "https://to.zymi.app:8443/task/deck", "expect": {"not_ours": true}},
    {"id": "x-other-build-scheme", "lane": "local", "note": "Another lane's scheme (zymi-dev, on a zymi-debug build) is that lane's link, as its host would be: reported, never opened.", "input": "zymi-dev://open/task/deck", "expect": {"other_lane": "dev"}},
    {"id": "p-scheme-case", "lane": "prod", "note": "Schemes are case-insensitive (WHATWG lower-cases them): ZYMI:// is zymi://.", "input": "ZYMI://open/task/deck", "expect": {"link": {"kind": "task", "id": "deck"}, "source": "scheme"}},
    {"id": "x-zim-retired", "lane": "dev", "note": "zim was ZIM's scheme until 11-13 and never left the developer's machine: not a legacy form, not ours.", "input": "zim://open/task/deck", "expect": {"not_ours": true}},
    {"id": "x-scheme-no-slashes", "lane": "prod", "note": "zymi:open/... has no host (no '//'), so it is not <scheme>://open: not ours.", "input": "zymi:open/task/deck", "expect": {"not_ours": true}},
    {"id": "x-zymix-open", "lane": "prod", "note": "zymix is ZYMIX's scheme (another product); only its legacy zymix://unseal/... is read, zymix://open/... is not ours.", "input": "zymix://open/task/deck", "expect": {"not_ours": true}},
    {"id": "x-debug-on-dev", "lane": "dev", "note": "A Debug build's scheme (zymi-debug) on a dev build is the local lane's.", "input": "zymi-debug://open/task/deck", "expect": {"other_lane": "local"}},
    {"id": "x-other-lane-scheme", "lane": "prod", "note": "dev's scheme on a prod build: dev's link.", "input": "zymi-dev://open/task/deck", "expect": {"other_lane": "dev"}},
    {"id": "x-other-lane-scheme-share", "lane": "prod", "note": "Any host and path behind another lane's scheme is that lane's (as any path on its https host), the Share extension's share included.", "input": "zymi-dev://share?inbox=abc", "expect": {"other_lane": "dev"}},
    {"id": "x-other-lane-scheme-case", "lane": "dev", "note": "Schemes are case-insensitive: ZYMI:// on a dev build is prod's.", "input": "ZYMI://open/task/deck", "expect": {"other_lane": "prod"}},
    {"id": "x-unknown-zymi-scheme", "lane": "prod", "note": "A scheme no lane in the config lists is not ours, however it is named: the parser reads schemes from the config, never guesses from zymi-<name>.", "input": "zymi-staging://open/task/deck", "expect": {"not_ours": true}},
    {"id": "x-javascript", "lane": "prod", "note": "Other schemes are not ours.", "input": "javascript:alert(1)", "expect": {"not_ours": true}},
    {"id": "l-matrixto-user", "lane": "prod", "note": "Legacy matrix.to user link (also the form mention pills keep).", "input": "https://matrix.to/#/@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app", "expect": {"link": {"kind": "user", "user_id": "@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}, "source": "matrix_to"}},
    {"id": "l-matrixto-room-v12", "lane": "dev", "note": "matrix.to room link with via (ignored).", "input": "https://matrix.to/#/!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30?via=localhost%3A8448", "expect": {"link": {"kind": "room", "room_id": "!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30"}, "source": "matrix_to"}},
    {"id": "l-matrixto-event", "lane": "prod", "note": "matrix.to message link: #/<room>/<$event>.", "input": "https://matrix.to/#/!abcDEF123:zymi.app/$Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4?via=zymi.app", "expect": {"link": {"kind": "room", "room_id": "!abcDEF123:zymi.app", "event_id": "$Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4"}, "source": "matrix_to"}},
    {"id": "l-matrixto-alias-raw", "lane": "prod", "note": "Alias with a raw '#' inside the fragment.", "input": "https://matrix.to/#/#team-alpha:zymi.app", "expect": {"link": {"kind": "room", "room_alias": "#team-alpha:zymi.app"}, "source": "matrix_to"}},
    {"id": "l-matrixto-alias-encoded", "lane": "prod", "note": "Alias percent-encoded (%23, %3A).", "input": "https://matrix.to/#/%23team-alpha%3Azymi.app", "expect": {"link": {"kind": "room", "room_alias": "#team-alpha:zymi.app"}, "source": "matrix_to"}},
    {"id": "l-to-share", "lane": "dev", "note": "Old landing page link: client=zymixdemo is ignored.", "input": "https://dev.unseal.chat/AgentMessenger/to-share/#/!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30?via=localhost%3A8448&client=zymixdemo", "expect": {"link": {"kind": "room", "room_id": "!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30"}, "source": "matrix_to"}},
    {"id": "l-matrixto-web-instance", "lane": "dev", "note": "web-instance[...] is ignored, never followed.", "input": "https://matrix.to/#/!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30?web-instance[element.io]=evil.example", "expect": {"link": {"kind": "room", "room_id": "!owtPMO14G1v6Yl9KlRjjDmlKdVC5NbSUPqbiF2Fru30"}, "source": "matrix_to"}},
    {"id": "l-zymix-room", "lane": "prod", "note": "ZYMIX deep link as matrix.to's Zymix client writes it (encodeURIComponent: '!' raw, ':' as %3A).", "input": "zymix://unseal/room/!abcDEF123%3Azymi.app?via=zymi.app", "expect": {"link": {"kind": "room", "room_id": "!abcDEF123:zymi.app"}, "source": "zymix"}},
    {"id": "l-zymix-user", "lane": "prod", "note": "ZYMIX user deep link.", "input": "zymix://unseal/user/%400b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70%3Azymi.app", "expect": {"link": {"kind": "user", "user_id": "@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}, "source": "zymix"}},
    {"id": "l-matrix-uri-user", "lane": "prod", "note": "matrix: URI (MSC2312); action=chat is only a hint.", "input": "matrix:u/0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app?action=chat", "expect": {"link": {"kind": "user", "user_id": "@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}, "source": "matrix_uri"}},
    {"id": "l-matrix-uri-event", "lane": "prod", "note": "matrix: URI room + event; action=join does not join.", "input": "matrix:roomid/abcDEF123:zymi.app/e/Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4?via=zymi.app&action=join", "expect": {"link": {"kind": "room", "room_id": "!abcDEF123:zymi.app", "event_id": "$Lh9m3k_ZqXo-2vT8pQ1rW5yA7cE0dF4gH6jK9lM2nB4"}, "source": "matrix_uri"}},
    {"id": "l-matrix-uri-alias", "lane": "prod", "note": "matrix: URI alias.", "input": "matrix:r/team-alpha:zymi.app", "expect": {"link": {"kind": "room", "room_alias": "#team-alpha:zymi.app"}, "source": "matrix_uri"}},
    {"id": "lx-matrix-uri-zymi", "lane": "prod", "note": "matrix: URIs (MSC2312) carry only u, r and roomid; Zymi kinds are not accepted there.", "input": "matrix:task/deck", "expect": {"reject": "unknown_kind"}},
    {"id": "lx-protocol-relative", "lane": "prod", "note": "#//evil.example/ must not become '//evil.example/' (open redirect): empty identifier, malformed.", "input": "https://matrix.to/#//evil.example/", "expect": {"reject": "malformed"}},
    {"id": "lx-foreign-user", "lane": "prod", "note": "Legacy links get the same server check.", "input": "https://matrix.to/#/@x:evil.example", "expect": {"reject": "foreign_server"}},
    {"id": "lx-group", "lane": "prod", "note": "Communities (+group) are not supported.", "input": "https://matrix.to/#/+group:zymi.app", "expect": {"reject": "unknown_kind"}},
    {"id": "lx-no-fragment", "lane": "prod", "note": "matrix.to without '#/' is just the website.", "input": "https://matrix.to/", "expect": {"not_ours": true}},
    {"id": "lx-unknown-base", "lane": "prod", "note": "The fragment form is only read on the listed legacy bases, never on any host.", "input": "https://evil.example/#/!abcDEF123:zymi.app", "expect": {"not_ours": true}},
    {"id": "x-kind-before-decode", "lane": "prod", "note": "The kind is matched literally before any id is decoded: an unknown kind wins over a bad escape.", "input": "https://to.zymi.app/bogus/x%zz", "expect": {"reject": "unknown_kind"}},
    {"id": "x-reserved-before-decode", "lane": "prod", "note": "Same for a reserved kind.", "input": "https://to.zymi.app/invite/x%zz", "expect": {"reject": "reserved"}},
    {"id": "x-kind-encoded", "lane": "prod", "note": "The kind segment is never decoded: %74ask is not 'task'.", "input": "https://to.zymi.app/%74ask/deck", "expect": {"reject": "unknown_kind"}},
    {"id": "x-zymi-double-encoded", "lane": "prod", "note": "Ids are decoded exactly once: %252F becomes '%2F', which a Zymi id refuses.", "input": "https://to.zymi.app/task/a%252Fb", "expect": {"reject": "malformed"}},
    {"id": "p-alias-double-encoded", "lane": "prod", "note": "Decoded once: an alias keeps the literal '%2F'.", "input": "https://to.zymi.app/r/a%252Fb:zymi.app", "expect": {"link": {"kind": "room", "room_alias": "#a%2Fb:zymi.app"}, "source": "canonical"}},
    {"id": "x-c1-control", "lane": "prod", "note": "Control characters are Unicode Cc, C1 (U+0080-U+009F) included.", "input": "https://to.zymi.app/r/a%C2%85:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "x-bad-utf8", "lane": "prod", "note": "Decoded bytes must be valid UTF-8 (here an overlong '/').", "input": "https://to.zymi.app/r/a%C0%AF:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "x-user-dup-sigil", "lane": "prod", "note": "The path carries the id without its sigil; a decoded id that starts with it ('@@x') is malformed.", "input": "https://to.zymi.app/u/%40x:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "x-user-bidi", "lane": "prod", "note": "A user localpart follows Matrix's historical grammar (printable ASCII but ':'): no spaces, no non-ASCII, no bidi controls.", "input": "https://to.zymi.app/u/a%E2%80%AEb:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "x-alias-bidi", "lane": "prod", "note": "An alias may be non-ASCII but never holds a format character (Cf: U+202E here) or white space.", "input": "https://to.zymi.app/r/a%E2%80%AEb:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "x-room-opaque-slash", "lane": "prod", "note": "A pre-v12 room id's opaque part follows the opaque identifier grammar [A-Za-z0-9._~-]: no '/'.", "input": "https://to.zymi.app/roomid/..%2F..:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "x-event-traversal", "lane": "prod", "note": "An event id is base64 ([A-Za-z0-9+/=_-], rooms v3+) or opaque:server (rooms v1-v2): '/../' and '?' never fit.", "input": "https://to.zymi.app/roomid/abc:zymi.app/e/%2F..%2Fx%3Fy", "expect": {"reject": "malformed"}},
    {"id": "p-event-dot-collapsed", "lane": "prod", "note": "WHATWG collapses %2e%2e before the grammar: this is the room without an event.", "input": "https://to.zymi.app/roomid/abc:zymi.app/e/%2e%2e", "expect": {"link": {"kind": "room", "room_id": "!abc:zymi.app"}, "source": "canonical"}},
    {"id": "p-server-case", "lane": "prod", "note": "Server names compare case-insensitively and come back lower-case (Matrix compares ids byte for byte).", "input": "https://to.zymi.app/u/x:ZYMI.APP", "expect": {"link": {"kind": "user", "user_id": "@x:zymi.app"}, "source": "canonical"}},
    {"id": "x-trailing-slashes", "lane": "prod", "note": "One trailing slash is tolerated, two are an empty segment.", "input": "https://to.zymi.app/task/deck//", "expect": {"reject": "malformed"}},
    {"id": "x-userinfo-host-trick", "lane": "prod", "note": "Everything before '@' is userinfo: the host is evil.example.", "input": "https://to.zymi.app@evil.example/task/deck", "expect": {"not_ours": true}},
    {"id": "x-homograph", "lane": "prod", "note": "A look-alike host (Cyrillic U+0456) becomes punycode and is another host.", "input": "https://to.zymі.app/task/deck", "expect": {"not_ours": true}},
    {"id": "x-other-lane-root", "lane": "prod", "note": "Any path on another lane's host is that lane's, its root included.", "input": "https://to-dev.zymi.app/", "expect": {"other_lane": "dev"}},
    {"id": "x-other-lane-credentials", "lane": "prod", "note": "Another lane's link with credentials is still that lane's: reported, never opened.", "input": "https://u:p@to-dev.zymi.app/task/deck", "expect": {"other_lane": "dev"}},
    {"id": "x-too-long-ours", "lane": "prod", "note": "Over 4096 bytes only the head is read; a link of ours there is malformed, never handed to the system.", "input": "https://to.zymi.app/task/deck?", "expect": {"reject": "malformed"}},
    {"id": "x-too-long-foreign", "lane": "prod", "note": "Over 4096 bytes on another host: not ours.", "input": "https://example.com/?", "expect": {"not_ours": true}},
    {"id": "x-too-long-root", "lane": "prod", "note": "Over 4096 bytes, the head is our host's root: the website, not a link, so not ours as it would be short.", "input": "https://to.zymi.app/?", "expect": {"not_ours": true}},
    {"id": "x-scheme-credentials", "lane": "dev", "note": "No credentials on <scheme>://open.", "input": "zymi-dev://u:p@open/task/deck", "expect": {"reject": "malformed"}},
    {"id": "x-scheme-port", "lane": "dev", "note": "No port on <scheme>://open.", "input": "zymi-dev://open:99/task/deck", "expect": {"reject": "malformed"}},
    {"id": "x-scheme-empty-segment", "lane": "dev", "note": "An empty segment is malformed on the scheme form too.", "input": "zymi-dev://open//task/deck", "expect": {"reject": "malformed"}},
    {"id": "lx-credentials", "lane": "prod", "note": "No credentials on a legacy base.", "input": "https://u:p@matrix.to/#/@x:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "lx-credentials-no-fragment", "lane": "prod", "note": "Without '#/' a legacy base is just the website, credentials or not.", "input": "https://u@matrix.to/", "expect": {"not_ours": true}},
    {"id": "lx-other-port", "lane": "prod", "note": "A legacy base on another port is another origin.", "input": "https://matrix.to:8443/#/@x:zymi.app", "expect": {"not_ours": true}},
    {"id": "lx-event-dots", "lane": "prod", "note": "The event id grammar holds on the fragment form too.", "input": "https://matrix.to/#/!abc:zymi.app/$..", "expect": {"reject": "malformed"}},
    {"id": "l-matrixto-user-path", "lane": "prod", "note": "The '#/user/@id' form mention pills also use (IMKit MatrixHTML.mentionedUser).", "input": "https://matrix.to/#/user/@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app", "expect": {"link": {"kind": "user", "user_id": "@0b1f0c3e-9a52-4b6e-8f1d-2c3b4a5d6e70:zymi.app"}, "source": "matrix_to"}},
    {"id": "lx-zymix-credentials", "lane": "prod", "note": "No credentials or port on a legacy scheme either.", "input": "zymix://u@unseal/user/%40x%3Azymi.app", "expect": {"reject": "malformed"}},
    {"id": "lx-matrix-uri-dots", "lane": "prod", "note": "matrix: paths are opaque (no dot-segment folding): '..' reaches the event grammar and fails.", "input": "matrix:roomid/abc:zymi.app/e/..", "expect": {"reject": "malformed"}},
    {"id": "lx-matrix-uri-authority", "lane": "prod", "note": "matrix: URIs have no authority: matrix://host/... starts with an empty segment.", "input": "matrix://evil.example/u/x:zymi.app", "expect": {"reject": "malformed"}},
    {"id": "lx-matrix-uri-arity", "lane": "prod", "note": "A user takes no event.", "input": "matrix:u/x:zymi.app/e/y", "expect": {"reject": "malformed"}}
  ]
}
