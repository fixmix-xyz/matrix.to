# Compose interpolation values for the dev lane's landing page (deploy/ec2/compose.yaml).
# Copy to /srv/zymi/links-dev/compose.env. Nothing here is a secret.
LINKS_COMPOSE_PROJECT=zymi-links-dev
# Built on the host from a source archive of this repository (deploy/ec2/README.md), so Compose never pulls it.
LINKS_IMAGE=zymi-links:dev-<short sha>
# The load balancer reaches the host on this port; the host security group admits it only from zymi-dev-alb.
LINKS_BIND_HOST=0.0.0.0
LINKS_HTTP_PORT=8110
